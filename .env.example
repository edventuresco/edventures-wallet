# Copy to .env.local (git-ignored). Devnet only; never put mainnet keys here.

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Which policy engine enforces family rules: mock | swig | postgres
POLICY_ENGINE=mock

# Who runs the waitlist at /admin: comma-separated emails. Unset = nobody.
ADMIN_EMAILS=

# Supabase (auth, database, realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in codes and kid invites go out through Resend (lib/email/resend.ts),
# as digits to type, never links. Server-only. RESEND_FROM must be on a
# domain verified in Resend; unset it means "Edventures Wallet <wallet@edventures.co>".
RESEND_API_KEY=
RESEND_FROM=

# Server-held keys as base58 secret keys. The fee payer covers transaction
# fees and, as the keeper role on each family wallet, pays allowances within
# the on-chain weekly cap. KEEPER_SECRET_KEY is only used by the spike script.
FEE_PAYER_SECRET_KEY=
KEEPER_SECRET_KEY=

# Protects /api/cron/allowance (the Monday allowance run in vercel.json).
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>"; 32+ random chars.
CRON_SECRET=

# Voice helper (server routes only; never exposed to the browser)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Sqril (QR payments, https://docs.sqril.io). Server-only; see docs/sqril-setup.md.
SQRIL_BASE_URL=https://stg-api.sqril.io
SQRIL_CLIENT_ID=
SQRIL_CLIENT_SECRET=
# Same value configured on the Sqril webhook (base64 HMAC-SHA256 of the raw body).
SQRIL_WEBHOOK_SECRET=
# Where a parent's shop payment lands on-chain (the family settling with Edventures). Defaults to the fee payer's wallet.
SHOP_SETTLEMENT_ADDRESS=
# true = canned responses for screen work, no Sqril calls.
SQRIL_MOCK=true
# Staging sample QR strings from Sqril, for the spike and the demo.
SQRIL_SAMPLE_QR=
SQRIL_SAMPLE_QR_STATIC=

# Devnet test mint (6 decimals), created by npm run mint.
USDC_MINT=
# Signs server-prepared transaction tokens; 32+ random chars (openssl rand -base64 48).
PREPARED_TX_SECRET=

# Swap on devnet: the fixed practice price, dollars per SOL (Jupiter prices mainnet).
DEVNET_SWAP_SOL_PRICE_USD=150

# The app's own origin, no trailing slash. Set in production so the landing
# page's app links stay absolute when edventures.co/wallet rewrites to it.
NEXT_PUBLIC_APP_ORIGIN=
