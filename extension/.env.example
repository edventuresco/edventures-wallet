# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-...

# OpenAI Model Configuration
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
VITE_OPENAI_MODEL=gpt-4-turbo-preview

# Maximum tokens per request (default: 1500)
# Higher values = longer responses but higher cost
VITE_OPENAI_MAX_TOKENS=1500

# Temperature (0.0 - 2.0, default: 0.7)
# Lower = more focused/deterministic, Higher = more creative/random
VITE_OPENAI_TEMPERATURE=0.7

# Agent Configuration
# Maximum conversation history messages to keep (default: 20)
VITE_AGENT_MAX_CONTEXT_MESSAGES=20

# Session timeout in milliseconds (default: 30 minutes)
VITE_AGENT_SESSION_TIMEOUT_MS=1800000

# Security Configuration
# Maximum requests per minute per session (default: 10)
VITE_AGENT_RATE_LIMIT_PER_MINUTE=10

# Maximum SOL amount for transactions (safety limit, default: 10)
VITE_AGENT_MAX_TRANSACTION_SOL=10

# ElevenLabs Configuration (for voice)
# Get your API key from: https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (optional, uses default if not set)
# Find voice IDs at: https://elevenlabs.io/voice-library
VITE_ELEVENLABS_VOICE_ID=

# ElevenLabs Model (optional, default: eleven_turbo_v2_5)
# Options: eleven_turbo_v2_5, eleven_monolingual_v1, eleven_multilingual_v2
VITE_ELEVENLABS_MODEL=eleven_turbo_v2_5

# Solana Configuration
# RPC endpoint (default: mainnet-beta)
# Options: https://api.mainnet-beta.solana.com, https://api.devnet.solana.com, custom RPC
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Feature Flags
# Enable AI agent features (default: true)
VITE_ENABLE_AGENT=true

# Enable voice conversation features (default: true)
VITE_ENABLE_VOICE=true

# Enable debug mode (logs more detailed info, default: false)
VITE_DEBUG_MODE=false
