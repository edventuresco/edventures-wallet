{
  "name": "edventures-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "A family wallet on Solana. Parents set the rules once, the rules live on-chain, and kids get a wallet that talks to them.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "NEXT_DIST_DIR=.next-build next build --turbopack",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node --import tsx scripts/make-pwa-icons.ts",
    "release": "NEXT_DIST_DIR=.next-build vercel deploy --prod",
    "keys": "node --env-file=.env.local --import tsx private/spike/keys.ts",
    "spike": "node --env-file=.env.local --import tsx private/spike/spike-swig.ts",
    "spike:sqril": "node --env-file=.env.local --import tsx private/spike/spike-sqril.ts",
    "mint": "node --env-file=.env.local --import tsx private/spike/mint.ts",
    "demo:reset": "node --env-file=.env.local --import tsx scripts/demo-reset.ts",
    "demo:seed": "node --env-file=.env.local --import tsx scripts/demo-seed.ts",
    "recover:root-key": "node --env-file=.env.local --import tsx scripts/move-root-key.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@jup-ag/api": "^6.0.48",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@swig-wallet/classic": "^2.1.0",
    "@swig-wallet/lib": "^2.1.0",
    "bs58": "^6.0.0",
    "jose": "^5.10.0",
    "jsqr": "^1.4.0",
    "lucide-react": "1.41.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.0.4"
  }
}
